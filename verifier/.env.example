# .env.example — Sensitive configuration for verifier
# Copy this file to .env and fill in your actual values.
# Note: When using only OpenAI (or OpenAI-compatible) API, the Anthropic section can be left
# empty; likewise, when using only Anthropic (or Anthropic-compatible) API, the OpenAI section
# can be left empty. Only configure the API family you actually use.

# ----- Anthropic (Claude) API -----
ANTHROPIC_API_KEY=
# Base URL for Anthropic API (without /v1 suffix)
# Official: https://api.anthropic.com
ANTHROPIC_BASE_URL=
CLAUDE_PROXY=

# ----- OpenAI-compatible API -----
OPENAI_API_KEY=
# Base URL for OpenAI-compatible API (with /v1/chat/completions suffix)
# Official: https://api.openai.com/v1/chat/completions
OPENAI_BASE_URL=

# ----- VLM API -----
VLM_OPENAI_API_KEY=
# Same format as OPENAI_BASE_URL (with /v1/chat/completions suffix)
VLM_OPENAI_BASE_URL=
VLM_CLAUDE_API_KEY=
# Same format as ANTHROPIC_BASE_URL (without /v1 suffix)
VLM_CLAUDE_BASE_URL=

# ----- Aesthetics & Functional Evaluator API -----
AESTHETICS_FUNCTIONAL_OPENAI_API_KEY=
# Same format as OPENAI_BASE_URL (with /v1/chat/completions suffix)
AESTHETICS_FUNCTIONAL_OPENAI_BASE_URL=

# ----- Agent-TARS API -----
AGENT_TARS_API_KEY=
# Same format as AGENT_BASE_URL (with /v1 suffix)
AGENT_TARS_BASE_URL=

# ----- Agent-TARS Server -----
AGENT_TARS_SERVER_URL=
BROWSER_CACHE_PATH=

# ----- Network Proxy -----
http_proxy=
no_proxy=

# ----- Browser Interception -----
# Internal domains to skip when intercepting browser requests (comma-separated)
LOCAL_DOMAINS=localhost,127.0.0.1

# ----- npm Registry -----
# Leave empty to use the default (https://registry.npmjs.org)
NPM_REGISTRY=